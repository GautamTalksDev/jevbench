.venv/

.cache/

# Pilot secrets / raw logs
pilot/.env.local
pilot/*.jsonl
# Unstripped pilot logs keep ChaosNLI premise/hypothesis — never commit
pilot/full/
# Stripped public logs: responses + item IDs + request_body_sha256 only
!pilot/stripped/
!pilot/stripped/*.jsonl

# Spend ledger (runtime)
budget.json

# Sealed local overnight status / logs
runs/SEALED_LOCAL*
logs/
pilot/run.log
